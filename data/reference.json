 "lore": [
  {
   "title": "序言：柯拉克的失蹤",
   "items": [
    {
     "text": "以柯拉克（Corak the Mysterious）的徒弟、年輕人昆登（Gwyn don the Young）的第一人稱報告寫成，"
    },
    {
     "text": "交代魔法師柯拉克失蹤的經過。"
    },
    {
     "text": "柯拉克是「征服者卡隆國王（King Kalohn the Vanquished）以外最具有威力的魔術師（Archmage）」。"
    },
    {
     "text": "柯拉克發現有個來自另一現實世界的罪犯，正潛逃進科隆（Cron）。"
    },
    {
     "text": "昆登偷聽到柯拉克自語，得知科隆已和一個名為席頓（Sheltem）的危險異形脫離了聯合狀態，"
    },
    {
     "text": "又提到「在可怕的波濤及無情的破壞橫掃整個科隆大地前，會有一神聖的鬥士重整整個大地」。"
    },
    {
     "text": "柯拉克舉止反常：進出研究室後常有形貌上的改變，有一次「出來時卻好像到過墨里休閒小島"
    },
    {
     "text": "（Murray's Resort Isle）作了一星期日光浴般，全身都變成褐色了」。"
    },
    {
     "text": "柯拉克取出「一隻我從未見過的奇異四爪棒」施法，在一聲巨響後消失。"
    },
    {
     "text": "一星期後潘赫特城主（Lord Pinehurst）來訪，同樣在研究室中消失；柯拉克的一項機械也不見了。"
    },
    {
     "text": "隔日潘赫特城主來信要昆登前往潘赫特城堡（Castle Pinehurst）繼續學習。"
    }
   ]
  },
  {
   "title": "科隆的歷史",
   "items": [
    {
     "text": "由柯拉克蒐集，昆登在皇家豪華宮殿（Luxus Palace Royale）的柯拉克研究室中找到。"
    },
    {
     "heading": "創世與四大自然種族（第 4–7 頁）"
    },
    {
     "text": "天地之間原本只有太虛，虛無中出現能發展生命的物質，科隆的歷史從此開始計算。"
    },
    {
     "text": "混沌中出現大量的水，和以太（ether）混在一起，誕生了奇異的種族。"
    },
    {
     "text": "為爭奪對水的控制權，自然諸神彼此混戰，最偉大者是亞郭蘭大（Acwalandear），"
    },
    {
     "text": "「所有水種（Water Kings）中最強大和最高貴者」，控制諸神約九十年。"
    },
    {
     "text": "一支強有力的種族進入科隆：風之精靈（Spirits of the Air），首領是恐怖而邪惡的雪文（Shalwend）。"
    },
    {
     "text": "風水戰爭持續一個世紀，最後達到彼此無法改變的平衡狀態。"
    },
    {
     "text": "亞郭蘭大命令奴隸創造最後的武器，其臣民召集了一群完全在水神控制下的新種族（火族）；"
    },
    {
     "text": "火族領導者為皮倫奈斯特（Pyrannaste）——火焰之主宰。"
    },
    {
     "text": "火族經過八十年奴役後反抗；水、風、火三族陷入五十年混戰。"
    },
    {
     "text": "更大的災禍是自稱大地之尊（Emperors of Earth）的種族，由殘忍的葛拉格（Gralkor the Cruel）領導，"
    },
    {
     "text": "凶猛入侵科隆。三族聯手，用「水浸透土族→火烘成乾泥→風吹散」的方法將土族根除。"
    },
    {
     "text": "但為時已晚：土族已聚集完成一塊浮於水上、不怕火也吹不散的大陸。經三十年抗爭失敗，"
    },
    {
     "text": "大地之尊主宰了這片日後稱為科隆的地方。"
    },
    {
     "text": "紀元五百年（以科隆初成形起算），葛拉格與土族建造固定的陸地區域；"
    },
    {
     "text": "其後約一百年間風、水、火、土四族共同修整，形成日後所知科隆的實體陸地部份。"
    },
    {
     "heading": "人類的興起與卡隆國王（第 7–10 頁）"
    },
    {
     "text": "第七世紀，一群小形生物在葛拉格的作品上繁衍，即人類。"
    },
    {
     "text": "水只能從他們身上滴落，風只能吹繞過，火能燒傷但極少致死，土地只能被他們踐踏。"
    },
    {
     "text": "人類可從四種自然諸神中提取精華加以利用，最重要的是能施展法術。"
    },
    {
     "text": "人類在科隆七十年後已能對抗諸神。最具威力的法師聚集在古代之島（Isle of Ancients）上，"
    },
    {
     "text": "合力創造了一顆能源水晶球：底座有四爪，每一爪針對一種自然力而設，能控制其所代表的諸神。"
    },
    {
     "text": "第八世紀末葉，一個魔法不高但充滿勇氣的人卡隆（Kalohn）測試水晶球並平安存活。"
    },
    {
     "text": "他登上科隆最高的山峰向四大主宰挑戰，戰勝諸神，把四大神族放逐到科隆大陸的四個邊區，"
    },
    {
     "text": "以各種障礙囚禁；四個爪子分別以水、風、火、土的形態出現看守，水晶球則留在自己身邊。"
    },
    {
     "text": "這場戰鬥使整座高山變成了死城（Dead Zone）大坑洞。"
    },
    {
     "text": "卡隆因此法力大增，成為魔術師卡隆國王（King Kalohn the Conjurer），理性統治三十年以上。"
    },
    {
     "text": "第九世紀中葉諸神反擊。亞郭蘭大研究魔法，創造出一具巨大怪獸並注入子民生命、賦予火，"
    },
    {
     "text": "即史上第一頭火龍。"
    },
    {
     "text": "卡隆國王在富足的大草原（Savannah of Plenty）與火龍相遇。水晶球已幾乎暗淡無光，"
    },
    {
     "text": "卡隆戰敗；他最後試圖以法術形成水牆保護自己，卻造成大洪水淹沒了自己和整片草原。"
    },
    {
     "text": "富足的大草原自此變成「亡命沼澤」（Quagmire of Death），水晶球據傳仍藏在沼澤某處，至今無人尋獲。"
    },
    {
     "text": "火龍經由一度關閉的走廊地帶進入科隆報復。卡隆國王的女兒拉曼達公主（Princess Lamanda）"
    },
    {
     "text": "成為大地的臨時主宰，文明水平大幅下降。"
    },
    {
     "text": "「現在是混亂的十世紀，劍及巫術取代原本生活中的法律及秩序。」"
    }
   ]
  }
 ],
 "puzzles": [
  {
   "title": "打字謎題的答案",
   "items": [
    {
     "text": "原版的謎底靠英文文字遊戲，翻成中文之後線索與答案對不起來 —— 這幾題不附答案就永遠解不開。"
    },
    {
     "text": "提問當下遊戲會把答案顯示在後面，這一頁是完整清單。"
    },
    {
     "text": "── 地下城的門禁碼"
    },
    {
     "text": "「What is the access code?」（門上的謎語自己會給提示）"
    },
    {
     "text": "  第一組：46 與 23"
    },
    {
     "text": "  第二組：64 與 32"
    },
    {
     "text": "── 野外的三道題"
    },
    {
     "text": "「我是你的守護天馬。我的名字是什麼？」 → MEENU"
    },
    {
     "text": "「馬克丟了什麼？」（Death Spider 的謎語） → KEYS"
    },
    {
     "text": "六塊巨石的祭壇問「通關密語？」 → DRUIDS"
    },
    {
     "text": "── 結局：控制室的中止碼"
    },
    {
     "text": "席頓留下的密碼電文解開之後是泰拉憲法的序言；電腦問「Enter override code to abort:」時要輸入的是 WAFE。"
    },
    {
     "text": "除了打對之外，隊伍裡還要有人身上帶著通關的旗標（角色記錄最後一個位元組的第 5 位），不然一樣不算。"
    }
   ]
  }
 ],
