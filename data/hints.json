   "kind": "interior",
   "entrance": {
    "area": "A2",
    "x": 1,
    "y": 3
   },
   "hints": [
    {
     "text": "大廳周圍門上的刻字連起來是：小心時間陷阱，因為世界將在 1000 年滅亡。",
     "from": "008.md:89",
     "level": "推論"
